
<html>
<head>
    <title>JavaScript Function Example</title>
</head>
<body>

    <button onclick="myFunction()">Click Me</button>

    <script>
        function myFunction() {
            alert("Hello from JavaScript!");
        }
    </script>

</body>
</html>


<script>
function myFunction() {

  const key = "testkey";
  const value = "Rob";

  localStorage.setItem(key, value);

}

</script>
